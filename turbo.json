{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"APP_ENV",
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"BETTER_AUTH_TRUSTED_ORIGINS",
		"ANALYZER_INTERNAL_URL",
		"ANALYZER_SERVICE_TOKEN",
		"S3_ENDPOINT",
		"S3_REGION",
		"S3_BUCKET",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"S3_FORCE_PATH_STYLE",
		"MAX_EML_BYTES",
		"UPLOAD_TIMEOUT_MS",
		"ANALYZER_REQUEST_TIMEOUT_MS",
		"RETENTION_DAYS",
		"TEST_DATABASE_URL",
		"SEED_ORGANIZATION_NAME",
		"SEED_ORGANIZATION_SLUG",
		"SEED_ANALYST_EMAIL",
		"SEED_ANALYST_PASSWORD",
		"SEED_SUPERVISOR_EMAIL",
		"SEED_SUPERVISOR_PASSWORD"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "package.json", "pnpm-lock.yaml", "tsconfig*.json", "pyproject.toml", "uv.lock"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**", "build/**"]
		},
		"lint": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"package.json",
				"pnpm-lock.yaml",
				"pyproject.toml",
				"uv.lock",
				"biome.json",
				"eslint.config.*",
				".prettierrc*"
			],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"package.json",
				"pnpm-lock.yaml",
				"pyproject.toml",
				"uv.lock",
				"tsconfig*.json",
				".mypy*"
			],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^test"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"package.json",
				"pnpm-lock.yaml",
				"pyproject.toml",
				"uv.lock",
				"apps/*/tests/**",
				"apps/*/src/**/*.test.*",
				"packages/*/src/**/*.test.*"
			],
			"outputs": []
		},
		"format:check": {
			"inputs": ["$TURBO_DEFAULT$", "package.json", "pnpm-lock.yaml", "pyproject.toml", "uv.lock", ".prettierrc*"],
			"outputs": []
		},
		"contracts:generate": {
			"dependsOn": ["^contracts:generate"],
			"outputs": []
		},
		"db:generate": {
			"dependsOn": ["^db:generate"],
			"cache": false,
			"outputs": []
		},
		"db:migrate": {
			"dependsOn": ["^db:migrate"],
			"cache": false,
			"outputs": []
		}
	}
}
