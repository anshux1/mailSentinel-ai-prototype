{
	"name": "@mailsentinel/db",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./repositories/*": "./src/repositories/*.ts",
		"./test-utils": "./src/test-utils.ts"
	},
	"scripts": {
		"auth:schema:generate": "auth generate --config=../auth/src/schema-config.ts --adapter=drizzle --dialect=postgresql --output=./src/schema/auth.ts --yes",
		"db:check": "tsx scripts/check.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
		"db:seed": "tsx seed.ts",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"check-types": "pnpm typecheck",
		"test": "vitest run"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.2",
		"better-auth": "1.7.2",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@mailsentinel/biome-config": "workspace:^",
		"@mailsentinel/typescript-config": "workspace:*",
		"@types/node": "^22.15.3",
		"@types/pg": "^8.15.5",
		"@biomejs/biome": "2.3.8",
		"auth": "1.7.2",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.20.3",
		"typescript": "5.9.2",
		"vitest": "^3.2.7"
	}
}
