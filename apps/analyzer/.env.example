ANALYZER_SERVICE_NAME=mailsentinel-analyzer
ANALYZER_SERVICE_VERSION=0.1.0
APP_ENV=development
ANALYSIS_VERSION=prototype-1
ENRICHMENT_MODE=fixture
DATABASE_URL=postgresql://mailsentinel:replace-me@localhost:5432/mailsentinel
REDIS_URL=redis://:replace-me@localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mailsentinel-evidence
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true
ANALYZER_SERVICE_TOKEN=replace-with-local-service-token
MAX_EML_BYTES=26214400
MAX_MIME_PARTS=200
MAX_HEADER_COUNT=1000
MAX_URLS=500
MAX_ATTACHMENT_BYTES=10485760
MAXMIND_DB_PATH=
ABUSEIPDB_API_KEY=
RETENTION_DAYS=90
READINESS_CHECKS_ENABLED=true
ANALYZER_PORT=8000
