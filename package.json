{
	"name": "mailsentinel",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"engines": {
		"node": ">=22.0.0 <23.0.0"
	},
	"scripts": {
		"dev": "turbo run dev",
		"dev:web": "turbo run dev --filter @mailsentinel/web",
		"dev:analyzer": "turbo run dev --filter @mailsentinel/analyzer",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"format": "prettier --write \"*.{json,md,yaml,yml}\" \"apps/**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\" \"packages/**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\" \"docs/**/*.{md,yaml,yml}\" \"infra/**/*.{yaml,yml,md}\" \".github/**/*.{yaml,yml,md}\"",
		"format:check": "prettier --check \"*.{json,md,yaml,yml}\" \"apps/**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\" \"packages/**/*.{ts,tsx,js,mjs,css,json,md,yaml,yml}\" \"docs/**/*.{md,yaml,yml}\" \"infra/**/*.{yaml,yml,md}\" \".github/**/*.{yaml,yml,md}\"",
		"clean": "rm -rf .turbo apps/*/.next apps/*/.turbo apps/*/out apps/*/build apps/*/dist packages/*/.turbo packages/*/build packages/*/dist apps/*/.pytest_cache apps/*/.mypy_cache apps/*/.ruff_cache apps/*/coverage packages/*/coverage",
		"infra:up": "bash infra/scripts/up.sh",
		"infra:down": "bash infra/scripts/down.sh",
		"infra:reset": "bash infra/scripts/reset.sh",
		"db:generate": "pnpm --filter @mailsentinel/db db:generate",
		"auth:schema:generate": "pnpm --filter @mailsentinel/db auth:schema:generate",
		"db:migrate": "pnpm --filter @mailsentinel/db db:migrate",
		"db:seed": "pnpm --filter @mailsentinel/db db:seed",
		"db:check": "pnpm --filter @mailsentinel/db db:check",
		"test:e2e": "pnpm --filter @mailsentinel/web test:e2e",
		"check-types": "turbo run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"prettier": "^3.6.2",
		"turbo": "^2.10.12",
		"typescript": "5.9.2"
	}
}
